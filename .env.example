# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key - https://resend.com/api-keys
# Free tier: 3,000 emails/month, no domain and no card required.
# While using the shared onboarding@resend.dev sender, mail can only be
# delivered to the address that owns this Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional override for where contact form submissions are delivered. Leave it
# unset in production - the route defaults to the contact@dkaylabs.com Zoho
# group, which fans out to the whole team. Set it only to divert submissions
# somewhere else, e.g. a personal inbox while testing locally.
# CONTACT_INBOX=you@example.com

# Canonical origin, no trailing slash. Only needed if this deploy is NOT the
# production domain - preview builds should set their own URL so canonicals
# and OG tags don't point at production. Defaults to https://dkaylabs.com.
# NEXT_PUBLIC_SITE_URL=https://dkaylabs.com
